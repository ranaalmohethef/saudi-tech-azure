			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_Crossref_API",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": "works?filter=ror-id:01q3tbs38,from-pub-date:2024-01-01,until-pub-date:2026-12-31&rows=100&cursor=*&mailto=ranaa.almohethef@gmail.com"
				},
				"schema": []
