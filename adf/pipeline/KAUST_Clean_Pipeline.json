							"text": "INSERT INTO research.publications AS p (research_id, university, title, authors, publication_year, publication_date, abstract, research_field, tech_category, journal, doi, url, source, has_doi, abstract_word_count) SELECT DISTINCT ON (research_id) research_id, university, title, authors, publication_year, publication_date, abstract, research_field, tech_category, journal, doi, url, source, COALESCE(has_doi, doi IS NOT NULL), COALESCE(abstract_word_count, 0) FROM research.publications_staging ORDER BY research_id ON CONFLICT (research_id) DO UPDATE SET university = EXCLUDED.university, title = EXCLUDED.title, authors = EXCLUDED.authors, publication_year = EXCLUDED.publication_year, publication_date = EXCLUDED.publication_date, abstract = EXCLUDED.abstract, research_field = EXCLUDED.research_field, tech_category = EXCLUDED.tech_category, journal = EXCLUDED.journal, doi = EXCLUDED.doi, url = EXCLUDED.url, source = EXCLUDED.source, has_doi = EXCLUDED.has_doi, abstract_word_count = EXCLUDED.abstract_word_count, loaded_at = now();"
