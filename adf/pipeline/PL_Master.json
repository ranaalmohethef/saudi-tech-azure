{
	"name": "PL_Master",
	"properties": {
		"activities": [
			{
				"name": "RunKaust",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "GetEmailUrl",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "KAUST_Clean_Pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "RunCrossref",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunKaust",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Ingest_Crossref",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "RunKsu",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunCrossref",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Ingest_KSU",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"year": {
							"value": "@createArray(2023,2024,2025)",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "RunKfupm",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunKsu",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Ingest_KFUPM",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"year": {
							"value": "@createArray(2023,2024,2025,2026)",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "RunFinal",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunOpenAlex",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Final_Union",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "RunOpenAlex",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "RunKfupm",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Ingest_OpenAlex",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"rors": {
							"value": "@createArray('02ma4wv74','052kwzs30','04jt46d36')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "QualityCheck",
				"type": "AzureFunctionActivity",
				"dependsOn": [
					{
						"activity": "RunFinal",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"functionName": "quality_check",
					"body": {
						"caller": "adf"
					},
					"method": "POST"
				},
				"linkedServiceName": {
					"referenceName": "LS_Func_Process",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "UpdateStats",
				"type": "AzureFunctionActivity",
				"dependsOn": [
					{
						"activity": "QualityCheck",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"functionName": "update_stats",
					"body": {
						"caller": "adf"
					},
					"method": "POST"
				},
				"linkedServiceName": {
					"referenceName": "LS_Func_Process",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "EmailSuccess",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "UpdateStats",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@activity('GetEmailUrl').output.value",
						"type": "Expression"
					},
					"body": {
						"status": "Succeeded",
						"pipeline": "@{pipeline().Pipeline}",
						"runId": "@{pipeline().RunId}",
						"message": "final_dataset has @{activity('QualityCheck').output.total_rows} rows and all quality checks passed. Validated records: @{activity('UpdateStats').output.validated_total}."
					}
				}
			},
			{
				"name": "EmailFailure",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "UpdateStats",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@activity('GetEmailUrl').output.value",
						"type": "Expression"
					},
					"body": {
						"status": "Failed",
						"pipeline": "@{pipeline().Pipeline}",
						"runId": "@{pipeline().RunId}",
						"message": "PL_Master failed. Open Data Factory, go to Monitor, and search for this Run ID to see which step failed."
					}
				}
			},
			{
				"name": "FailPipeline",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "EmailFailure",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "PL_Master failed",
					"errorCode": "500"
				}
			},
			{
				"name": "GetEmailUrl",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-saudi-tech-rana.vault.azure.net/secrets/logicapp-url?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-09-20T14:14:51Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}